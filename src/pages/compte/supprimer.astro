---
/**
 * /compte/supprimer — suppression du compte depuis le site (SCRUM-204).
 *
 * Même Edge Function que l'app (`delete-account`) : réauthentification par mot
 * de passe côté serveur, puis purge. Supprimer ici supprime aussi le compte de
 * l'app — c'est le même compte.
 *
 * Abonnement en cours (SCRUM-210) : la fonction l'annule elle-même chez Stripe,
 * immédiatement, avant toute purge — et refuse de supprimer (503) si Stripe ne
 * répond pas. La page se contente de prévenir.
 */
import Account from '../../layouts/Account.astro';
import { CONTACT_EMAIL } from '../../lib/nav';
---

<Account
  title="Supprimer mon compte · TagePocket"
  description="Suppression définitive de ton compte TagePocket."
>
  <p class="retour"><a href="/compte">← Mon compte</a></p>
  <h1>Supprimer mon compte</h1>
  <p class="compte__email" data-email></p>

  <section class="carte" data-avertissement aria-labelledby="efface-titre">
    <h2 id="efface-titre">Ce qui sera effacé, définitivement</h2>
    <ul class="liste">
      <li>ton compte et ton adresse e-mail, sur le site comme dans l'app ;</li>
      <li>ta progression, tes statistiques et ton historique de réponses ;</li>
      <li>ton pseudo et ta place dans les classements.</li>
    </ul>
    <p>
      Rien ne pourra être récupéré, pas même par nous. Si tu reviens un jour, tu
      repartiras de zéro.
    </p>
    <h2 class="sous-titre">Ce qui est conservé</h2>
    <p>
      Si tu as payé un abonnement, tes factures restent archivées chez notre
      prestataire de paiement pendant 10 ans : c'est une obligation comptable
      (art. L123-22 du Code de commerce). Elles ne sont plus rattachées à aucun
      compte TagePocket.
    </p>
  </section>

  <section class="carte carte--abonne" data-abonne hidden aria-labelledby="abonne-titre">
    <h2 id="abonne-titre">Ton abonnement prendra fin tout de suite</h2>
    <p>
      Ton accès premium court encore. Supprimer ton compte y met fin
      immédiatement : plus aucun prélèvement, mais pas de remboursement du temps
      restant.
    </p>
    <p>
      Abonné depuis moins de 14 jours ? Tu as droit au remboursement intégral :
      écris-nous à <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <strong>avant</strong> de supprimer ton compte.
    </p>
  </section>

  <form class="carte" data-form novalidate>
    <h2>Confirme avec ton mot de passe</h2>
    <label class="champ">
      Mot de passe
      <input name="password" type="password" autocomplete="current-password" required />
    </label>
    <label class="coche">
      <input name="compris" type="checkbox" required />
      Je comprends que la suppression est définitive.
    </label>
    <p class="alerte" data-alerte role="alert"></p>
    <button type="submit" class="bouton-danger">Supprimer définitivement mon compte</button>
    <p class="oubli">
      Mot de passe oublié ?
      <a href="/connexion?vue=reinit">Choisis-en un nouveau</a>, puis reviens ici.
    </p>
  </form>

  <section class="carte" data-fait hidden aria-labelledby="fait-titre">
    <img src="/brand/gaston-endormi.svg" alt="" width="72" height="72" />
    <h2 id="fait-titre">Ton compte est supprimé</h2>
    <p>
      Tout a été effacé. Si l'app est ouverte sur ton téléphone, elle te
      déconnectera d'elle-même. Merci d'être passé par la clairière.
    </p>
    <p><a href="/">Retour à l'accueil</a></p>
  </section>
</Account>

<style>
  .retour {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .liste {
    margin-top: var(--space-3);
    padding-left: var(--space-6);
    color: var(--ink-2);
  }

  .sous-titre {
    margin-top: var(--space-6);
  }

  .carte--abonne p + p {
    margin-top: var(--space-3);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .champ input {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    background: var(--app-bg);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
  }

  .coche {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-sm);
  }

  .coche input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    accent-color: var(--bad-ink);
  }

  .alerte {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--bad-ink);
    background: var(--bad-soft);
    border-radius: var(--radius-sm);
  }

  .alerte:empty {
    display: none;
  }

  /* Détruire n'est pas agir au sens de la menthe : le seul bouton rouge du site.
     Fond --bad-ink et texte blanc, 8:1 ; le --bad pur n'atteint pas 4,5:1. */
  .bouton-danger {
    padding: var(--space-3) var(--space-6);
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: var(--bad-ink);
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .bouton-danger:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .oubli {
    font-size: var(--text-sm);
  }
</style>

<script>
  import { FunctionsFetchError, FunctionsHttpError } from '@supabase/supabase-js';
  import { supabase } from '../../lib/supabase';
  import { devoiler, requireSession, sessionPerimee } from '../../lib/guard';
  import { etatAbonnement, type LigneAbonnement } from '../../lib/abonnement';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');
  const bouton = $<HTMLButtonElement>('button[type="submit"]');
  const alerte = $('[data-alerte]');

  /** Un accès premium en cours, même déjà résilié pour la fin de période. */
  async function abonnementEnCours(): Promise<boolean | 'perimee'> {
    const { data, error, status } = await supabase
      .from('subscriptions')
      .select('status, plan, current_period_end, cancel_at_period_end, trial_end, canceled_at, created_at');
    if (status === 401) return 'perimee';
    // En cas de doute, on prévient : l'encart ne bloque rien, il informe.
    if (error) return true;
    const e = etatAbonnement((data ?? []) as LigneAbonnement[]);
    return e.type === 'impaye' || e.type === 'essai' || e.type === 'actif';
  }

  async function supprimer(password: string): Promise<void> {
    const { error } = await supabase.functions.invoke('delete-account', { body: { password } });
    if (!error) return;

    if (error instanceof FunctionsHttpError) {
      const reponse = error.context as Response;
      const corps = (await reponse.json().catch(() => ({}))) as { error?: string };
      if (reponse.status === 401 && corps.error === 'invalid_password') {
        throw new Error('Mot de passe incorrect.');
      }
      // Jeton refusé par la fonction : la session n'est plus valable.
      if (reponse.status === 401) {
        await sessionPerimee();
        throw new Error('Ta session a expiré. Reconnecte-toi.');
      }
      // Stripe injoignable : l'abonnement n'a pas pu être résilié, donc rien
      // n'a été supprimé (SCRUM-210).
      if (reponse.status === 503 && corps.error === 'billing_unavailable') {
        throw new Error(
          "Ton abonnement n'a pas pu être résilié, rien n'a été supprimé. Réessaie dans quelques minutes.",
        );
      }
      throw new Error("La suppression n'a pas abouti. Réessaie, ou écris-nous.");
    }
    if (error instanceof FunctionsFetchError) throw new Error('Pas de connexion. Vérifie ton réseau.');
    throw new Error('Une erreur est survenue. Réessaie.');
  }

  async function main() {
    const session = await requireSession();
    if (!session) return;
    $('[data-email]').textContent = session.user.email ?? '';

    const abonne = await abonnementEnCours();
    if (abonne === 'perimee') return sessionPerimee();
    $('[data-abonne]').hidden = !abonne;
    devoiler();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    alerte.textContent = '';
    const donnees = new FormData(form);
    const password = String(donnees.get('password') ?? '');
    if (!donnees.get('compris')) {
      alerte.textContent = 'Coche la case pour confirmer que tu as bien compris.';
      return;
    }
    if (!password) {
      alerte.textContent = 'Entre ton mot de passe.';
      return;
    }

    bouton.disabled = true;
    try {
      await supprimer(password);
      // Le compte n'existe plus : la session locale ne vaut plus rien.
      await supabase.auth.signOut({ scope: 'local' });
      form.hidden = true;
      $('[data-avertissement]').hidden = true;
      $('[data-abonne]').hidden = true;
      $('[data-fait]').hidden = false;
      $('[data-email]').textContent = '';
    } catch (err) {
      alerte.textContent = err instanceof Error ? err.message : 'Une erreur est survenue.';
      bouton.disabled = false;
    }
  });

  main();
</script>
