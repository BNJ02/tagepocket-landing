---
/**
 * Page de contrôle du design system — TEMPORAIRE (SCRUM-195).
 *
 * Elle existe pour vérifier à l'écran ce qu'un `astro check` ne peut pas voir :
 * les graisses se chargent-elles vraiment, les contrastes annoncés tiennent-ils,
 * les quatre familles se distinguent-elles.
 *
 * À SUPPRIMER en fin de lot 1, avec son entrée dans robots.txt. En attendant
 * elle est en `noindex` et exclue du sitemap (astro.config.mjs).
 */
import Base from '../layouts/Base.astro';

type Cran = [token: string, hex: string, usage: string];

const menthe: Cran[] = [
  ['--accent-soft', '#d6f7ec', 'fond d’encart'],
  ['--accent', '#15c585', 'surface de CTA — 2,2:1, jamais de texte'],
  ['--accent-press', '#0ea271', 'état pressé — 3,3:1, jamais de texte'],
  ['--accent-strong', '#0a6d4a', 'liens et prix — 6,4:1, seule variante lisible'],
  ['--accent-ink', '#04261b', 'texte sur menthe'],
];

const bois: Cran[] = [
  ['--bois-100', '#f8f3ec', 'encart de lecture'],
  ['--bois-200', '#ede4d6', 'piste pressée'],
  ['--bois-300', '#ded6c6', 'séparateurs, tranche des cartes'],
  ['--bois-500', '#c19a6b', 'la bûche'],
  ['--bois-700', '#a67c52', 'base des boutons neutres'],
  ['--bois-900', '#6b452b', 'texte sur bois clair — 8,4:1'],
];

const eau: Cran[] = [
  ['--eau-100', '#eaf4f7', 'bassin vide'],
  ['--eau-300', '#bfe0eb', 'portion à venir'],
  ['--eau-500', '#3aa8c9', 'remplissage — 2,8:1, jamais de texte'],
  ['--eau-700', '#1c6f8c', 'texte sur eau claire — 5,7:1'],
  ['--eau-900', '#12414f', 'chiffre posé sur l’eau'],
];

const mousse: Cran[] = [
  ['--app-bg', '#eef1ea', 'la berge, fond de page'],
  ['--app-card', '#ffffff', 'le blanc des cartes'],
  ['--track', '#dfe5dc', 'la pierre, piste de barre'],
  ['--ink-4', '#a8bba7', 'icône désactivée — jamais de texte'],
  ['--ink-3', '#6f8a72', 'étiquettes — 3,8:1, gros texte seulement'],
  ['--ink-2', '#5c7460', 'texte secondaire — 5,1:1'],
  ['--ink', '#14241d', 'texte principal — 14,2:1'],
];

const familles: [nom: string, metier: string, crans: Cran[]][] = [
  ['Menthe', 'agit — le CTA, et rien d’autre', menthe],
  ['Bois', 'porte et sépare — jamais un état, jamais une action', bois],
  ['Eau', 'se remplit — tout ce qui monte, jamais ce qu’on presse', eau],
  ['Mousse', 'se tait — les neutres, tous biaisés vert, aucun gris pur', mousse],
];

const gastons = ['content', 'fier', 'inquiet', 'endormi'];
---

<Base
  title="Contrôle du design system — TagePocket"
  description="Page de vérification interne de la palette et de la typographie."
  noindex
>
  <div class="page ctrl">
    <p class="warn">
      Page de contrôle interne, temporaire — supprimée en fin de lot 1.
    </p>

    <h1>« La Clairière » sur le web</h1>
    <p>
      La question au moment de coder est « qu'est-ce que cet élément fait ? »,
      jamais « quelle couleur je mets ? ». Règle transverse : <strong>500
      remplit, 700 écrit</strong>.
    </p>

    {
      familles.map(([nom, metier, crans]) => (
        <section>
          <h2>{nom}</h2>
          <p class="metier">{metier}</p>
          <ul class="swatches">
            {crans.map(([token, hex, usage]) => (
              <li>
                <span class="chip" style={`background: var(${token})`} />
                <code>{token}</code>
                <span class="hex num">{hex}</span>
                <span class="usage">{usage}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section>
      <h2>Typographie</h2>
      <p class="metier">
        Hanken Grotesk auto-hébergée, graisses 400, 600 et 800. Si l'une de ces
        lignes s'affiche dans une autre police, le <code>@font-face</code>{' '}
        correspondant est cassé.
      </p>
      <p class="spec w400">Hanken Grotesk 400 — le corps de texte, 17 px.</p>
      <p class="spec w600">Hanken Grotesk 600 — les intertitres et le gras.</p>
      <p class="spec w800">Hanken Grotesk 800 — le titrage.</p>
      <p class="spec num" style="font-size: var(--text-xl)">
        JetBrains Mono 600 — 8,99 € · 24,99 € · 600/600 · 0123456789
      </p>
    </section>

    <section>
      <h2>Éléments</h2>
      <p class="metier">
        Le seul emploi de la menthe pleine est le CTA. Les boutons neutres
        reposent sur le bois.
      </p>
      <p class="demo">
        <a class="btn btn--accent" href="#">Commencer l'essai</a>
        <a class="btn btn--neutre" href="#">En savoir plus</a>
        <span class="badge">Premium</span>
      </p>
      <p class="demo">
        <span class="gauge"><span class="gauge__fill" style="width: 21%"></span></span>
        <span class="gauge__label">Essai — jour <span class="num">3</span> sur <span class="num">14</span></span>
      </p>
    </section>

    <section>
      <h2>Gaston</h2>
      <p class="metier">
        Quatre humeurs, une par situation. Le castor est décoratif :{' '}
        <code>alt=""</code> partout, le sens est porté par le texte voisin.
      </p>
      <ul class="gastons">
        {
          gastons.map((g) => (
            <li>
              <img src={`/brand/gaston-${g}.svg`} alt="" width="120" height="120" />
              <code>{g}</code>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .ctrl {
    padding-block: var(--space-12);
  }

  .warn {
    max-width: none;
    margin-bottom: var(--space-8);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bad-soft);
    color: var(--bad-ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  section {
    margin-top: var(--space-16);
  }

  .metier {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }

  .swatches {
    list-style: none;
    margin-top: var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .swatches li {
    display: grid;
    grid-template-columns: 3rem 11rem 6rem 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--app-card);
    font-size: var(--text-sm);
  }

  .chip {
    width: 3rem;
    height: 2rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
  }

  .hex,
  .usage {
    color: var(--ink-2);
  }

  .spec {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
  }

  .w400 {
    font-weight: 400;
  }
  .w600 {
    font-weight: 600;
  }
  .w800 {
    font-weight: 800;
  }

  .demo {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .btn {
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    font-weight: 600;
    text-decoration: none;
  }

  .btn--accent {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 4px 0 var(--accent-press);
  }

  .btn--neutre {
    background: var(--bois-100);
    color: var(--bois-900);
    box-shadow: 0 4px 0 var(--bois-700);
  }

  .badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--gold);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .gauge {
    flex: 0 0 14rem;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--track);
    overflow: hidden;
  }

  .gauge__fill {
    display: block;
    height: 100%;
    background: var(--eau-500);
  }

  .gauge__label {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .gastons {
    list-style: none;
    margin-top: var(--space-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .gastons li {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  @media (max-width: 40rem) {
    .swatches li {
      grid-template-columns: 2.5rem 1fr;
      row-gap: var(--space-1);
    }
    .hex,
    .usage {
      grid-column: 2;
    }
  }
</style>
