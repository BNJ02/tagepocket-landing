---
/**
 * /tarifs — les deux formules et le départ vers le paiement (SCRUM-209).
 *
 * Décisions du 26/09/2026, qui remplacent la description d'origine du ticket :
 *   - pas d'essai gratuit : le premier prélèvement a lieu à la souscription ;
 *   - pas de case de renonciation à la rétractation : toute rétractation sous
 *     14 jours est remboursée en entier (voir RETRACTATION_JOURS, offre.ts).
 * Reste l'obligation d'informer AVANT le paiement (art. L221-5 C. conso) :
 * c'est le bloc « Avant de payer », placé au-dessus des boutons.
 *
 * Le bouton n'envoie que la clé de la formule (`monthly` | `quarterly`) à
 * `create-checkout-session`. Le prix débité est résolu côté serveur ; rien de
 * ce qui est affiché ici ne pilote le paiement.
 *
 * Tant que PAIEMENT_OUVERT est faux (Stripe en mode test), les boutons sont
 * masqués et remplacés par « Bientôt disponible ». `?apercu` les affiche pour
 * les comptes de test ; la vraie barrière est côté serveur (voir nav.ts).
 */
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, LEGAL_NAV, PAIEMENT_OUVERT } from '../lib/nav';
import {
  AVANTAGES_PREMIUM,
  FORMULES,
  MENTION_TVA,
  RETRACTATION_JOURS,
  nombre,
  parMois,
} from '../lib/offre';

const cgv = LEGAL_NAV.find((l) => l.href === '/cgv');
---

<Base
  title="Tarifs · TagePocket"
  description={`Le premium TagePocket : ${nombre(FORMULES[0].prix)} € par mois ou ${nombre(FORMULES[1].prix)} € tous les 3 mois, sans engagement, remboursé sous ${RETRACTATION_JOURS} jours si tu changes d'avis.`}
>
  <div class="page tarifs">
    <h1>Passe au premium</h1>
    <p class="tarifs__lead">
      Tout TagePocket, sans limite. Tu t’abonnes ici, tu te connectes dans l’app avec
      le même compte, et tout est débloqué.
    </p>

    <p class="bandeau" data-bandeau role="status" hidden></p>

    <ul class="avantages">
      {AVANTAGES_PREMIUM.map((a) => <li>{a}</li>)}
    </ul>

    <section class="avant" aria-labelledby="avant-titre">
      <h2 id="avant-titre">Avant de payer</h2>
      <ul>
        <li>
          Tu paies à la souscription, puis automatiquement à chaque échéance, jusqu’à
          ce que tu résilies. Sans engagement.
        </li>
        <li>
          <strong>
            Tu changes d’avis dans les <span class="num">{RETRACTATION_JOURS}</span> jours ?
            On te rembourse en entier
          </strong>, même si tu as déjà utilisé le premium. Écris-nous à{' '}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, sans avoir à te
          justifier.
        </li>
        <li>
          Tu résilies depuis ton compte, en deux clics. Tu gardes l’accès jusqu’à la fin
          de la période payée, et plus rien n’est prélevé.
        </li>
        <li>
          Le paiement se fait sur la page sécurisée de Stripe, notre prestataire : ta
          carte n’est jamais saisie ni conservée sur notre site.
        </li>
        {
          cgv?.ready && (
            <li>
              Le détail est dans nos <a href={cgv.href}>conditions générales de vente</a>.
            </li>
          )
        }
      </ul>
    </section>

    <ul class="formules">
      {
        FORMULES.map((f) => (
          <li class={`formule${f.avantage ? ' formule--phare' : ''}`} data-formule={f.id}>
            {f.avantage && <p class="formule__ruban">{f.avantage}</p>}
            <h2>{f.nom}</h2>
            <p class="formule__prix">
              <span class="formule__montant">
                <span class="num">{nombre(f.prix)}</span> €
              </span>
              <span class="formule__periode">{f.periode}</span>
            </p>
            {f.mois > 1 && (
              <p class="formule__mensualise">
                soit <span class="num">{nombre(parMois(f))}</span> € par mois
              </p>
            )}
            <p class="formule__tva">{MENTION_TVA}</p>
            <button
              type="button"
              class="bouton"
              data-plan={f.id}
              data-libelle={`Choisir le ${f.nom.toLowerCase()}`}
              hidden={!PAIEMENT_OUVERT}
            >
              Choisir le {f.nom.toLowerCase()}
            </button>
          </li>
        ))
      }
    </ul>

    <p class="erreur" data-erreur role="alert" hidden></p>

    <p class="bientot" data-bientot hidden={PAIEMENT_OUVERT}>
      <strong>Bientôt disponible.</strong> Le paiement ouvre très prochainement. Écris-nous
      à <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> pour être prévenu.
    </p>
  </div>
</Base>

<style>
  .tarifs {
    max-width: 48rem;
    padding-block: var(--space-12) var(--space-24);
  }

  .tarifs__lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .bandeau {
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--ink);
    background: var(--bois-100);
  }

  .avantages {
    margin-top: var(--space-8);
    padding-left: var(--space-6);
    color: var(--ink-2);
  }

  .avantages li + li {
    margin-top: var(--space-2);
  }

  /* Bois porte et sépare : l'encart d'information, comme sur les pages légales. */
  .avant {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-left: 4px solid var(--bois-300);
    border-radius: var(--radius);
    background: var(--bois-100);
  }

  .avant h2 {
    font-size: var(--text-lg);
  }

  .avant ul {
    margin-top: var(--space-3);
    padding-left: var(--space-6);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .avant li + li {
    margin-top: var(--space-2);
  }

  .avant strong {
    color: var(--ink);
  }

  .formules {
    list-style: none;
    padding: 0;
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-6);
  }

  .formule {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border: 1px solid var(--bois-300);
    border-radius: var(--radius-lg);
    background: var(--app-card);
  }

  .formule--phare {
    border-color: var(--accent);
  }

  /* La formule choisie avant de passer par /connexion. */
  .formule[data-choisie] {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .formule h2 {
    font-size: var(--text-xl);
  }

  .formule__ruban {
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: var(--space-6);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--gold);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .formule__prix {
    margin-top: var(--space-4);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .formule__montant {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--accent-strong);
    letter-spacing: -0.02em;
  }

  .formule__periode,
  .formule__mensualise {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .formule__mensualise {
    margin-top: var(--space-1);
  }

  .formule__tva {
    margin-block: var(--space-4) var(--space-6);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  /* Menthe = agir. Texte en --accent-ink : la menthe est une surface.
     `margin-top: auto` aligne les deux boutons en bas des cartes. */
  .bouton {
    margin-top: auto;
    padding: var(--space-3) var(--space-6);
    font: inherit;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 0 var(--accent-press);
    cursor: pointer;
  }

  .bouton:hover {
    color: var(--brand-ink);
    background: var(--accent-press);
  }

  .bouton:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .erreur {
    margin-top: var(--space-6);
    color: var(--bad-ink);
  }

  .bientot {
    margin-top: var(--space-8);
    color: var(--ink-2);
  }
</style>

<script>
  import { FunctionsHttpError } from '@supabase/supabase-js';
  import { supabase } from '../lib/supabase';
  import { PAIEMENT_OUVERT } from '../lib/nav';
  import { FORMULES, type PlanId } from '../lib/offre';

  const params = new URLSearchParams(window.location.search);
  const apercu = params.has('apercu');
  const boutons = [...document.querySelectorAll<HTMLButtonElement>('[data-plan]')];
  const bandeau = document.querySelector<HTMLElement>('[data-bandeau]')!;
  const erreur = document.querySelector<HTMLElement>('[data-erreur]')!;

  const estPlan = (p: string | null): p is PlanId => FORMULES.some((f) => f.id === p);

  function dire(el: HTMLElement, texte: string | null) {
    el.textContent = texte ?? '';
    el.hidden = !texte;
  }

  /** Retire des paramètres de l'URL : un rechargement ne rejoue pas le message. */
  function consommer(...cles: string[]) {
    for (const c of cles) params.delete(c);
    const reste = params.toString();
    history.replaceState(null, '', window.location.pathname + (reste ? `?${reste}` : ''));
  }

  /** /tarifs, formule présélectionnée, pour le retour après /connexion. */
  const retour = (plan: PlanId) => `/tarifs?plan=${plan}${apercu ? '&apercu' : ''}`;

  const versConnexion = (plan: PlanId) =>
    window.location.assign(`/connexion?next=${encodeURIComponent(retour(plan))}`);

  function occupe(actif: boolean, bouton?: HTMLButtonElement) {
    for (const b of boutons) {
      b.disabled = actif;
      b.textContent = b.dataset.libelle!;
    }
    if (actif && bouton) bouton.textContent = 'Ouverture du paiement…';
  }

  /* La page de paiement doit être celle de Stripe, et rien d'autre : l'URL
     vient de notre fonction, mais on ne redirige pas les yeux fermés. */
  function pageStripe(url: string): boolean {
    try {
      const u = new URL(url);
      return u.protocol === 'https:' && u.hostname === 'checkout.stripe.com';
    } catch {
      return false;
    }
  }

  async function choisir(plan: PlanId, bouton: HTMLButtonElement) {
    dire(erreur, null);
    occupe(true, bouton);

    const { data: s } = await supabase.auth.getSession();
    if (!s.session) return versConnexion(plan);

    const { data, error } = await supabase.functions.invoke<{ url: string }>(
      'create-checkout-session',
      { body: { plan } },
    );
    if (!error && data?.url && pageStripe(data.url)) {
      window.location.assign(data.url);
      return;
    }

    const statut = error instanceof FunctionsHttpError ? (error.context as Response).status : 0;
    if (statut === 401) {
      // Session révoquée ailleurs : on l'oublie ICI seulement, jamais dans l'app.
      await supabase.auth.signOut({ scope: 'local' });
      return versConnexion(plan);
    }
    if (statut === 409) {
      // Déjà abonné : son abonnement se gère depuis son compte.
      window.location.assign('/compte');
      return;
    }
    occupe(false);
    dire(
      erreur,
      statut === 403
        ? 'Le paiement n’est pas encore ouvert. Reviens très bientôt !'
        : 'La page de paiement n’a pas pu s’ouvrir. Réessaie dans un instant.',
    );
  }

  // Aperçu pour les comptes de test (voir PAIEMENT_OUVERT dans nav.ts).
  if (!PAIEMENT_OUVERT && apercu) {
    for (const b of boutons) b.hidden = false;
    document.querySelector<HTMLElement>('[data-bientot]')!.hidden = true;
  }

  for (const b of boutons) {
    b.addEventListener('click', () => {
      const plan = b.dataset.plan ?? null;
      if (estPlan(plan)) void choisir(plan, b);
    });
  }

  // Retour d'une page de paiement abandonnée : rien n'a été débité.
  if (params.get('checkout') === 'cancel') {
    dire(bandeau, 'Paiement annulé : rien n’a été débité. Tu peux choisir une formule quand tu veux.');
    consommer('checkout');
  }

  /* Retour de /connexion : la formule cliquée avant de se connecter est mise en
     avant, et son bouton reçoit le focus. On ne lance PAS le paiement tout
     seul : c'est à l'utilisateur de confirmer, une fois connecté. */
  const plan = params.get('plan');
  if (estPlan(plan)) {
    consommer('plan');
    const bouton = boutons.find((b) => b.dataset.plan === plan);
    if (bouton && !bouton.hidden) {
      bouton.closest<HTMLElement>('[data-formule]')!.dataset.choisie = '';
      bouton.focus({ preventScroll: true });
      bouton.scrollIntoView({ block: 'center' });
      const { data: s } = await supabase.auth.getSession();
      if (s.session) dire(bandeau, 'C’est bon, ta session est ouverte. Il ne reste qu’à confirmer ta formule.');
    }
  }
</script>
