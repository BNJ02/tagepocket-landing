---
// Page 404 — première page portée sur le design system (SCRUM-195).
// Workers la sert avec un vrai statut 404 grâce à
// `assets.not_found_handling: "404-page"` dans wrangler.jsonc.
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../lib/nav';
---

<Base
  title="Page introuvable — TagePocket"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <div class="page notfound">
    <img src="/brand/gaston-inquiet.svg" alt="" width="180" height="180" />
    <p class="notfound__code num">404</p>
    <h1>Cette page n'existe pas</h1>
    <p>
      Le lien est peut-être périmé, ou l'adresse comporte une faute de frappe.
      Reviens à l'accueil — et écris-nous si tu penses que c'est un bug de notre
      côté.
    </p>
    <p class="notfound__links">
      <a href="/">Retour à l'accueil</a> · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </div>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-16);
  }

  .notfound p {
    max-width: 46ch;
  }

  .notfound__code {
    margin-top: var(--space-6);
    color: var(--ink-3);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  .notfound h1 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-2xl);
  }

  .notfound__links {
    margin-top: var(--space-6);
    color: var(--ink-3);
  }
</style>
