---
import Logo from './Logo.astro';
import { MAIN_NAV, HEADER_CTA, live } from '../lib/nav';

const links = live(MAIN_NAV);
const cta = HEADER_CTA.ready ? HEADER_CTA : null;
const path = Astro.url.pathname;
---

<header class="hdr">
  <div class="page hdr__in">
    <a href="/" class="hdr__home" aria-label="TagePocket — accueil">
      <Logo size={30} />
    </a>

    {
      (links.length > 0 || cta) && (
        <nav class="hdr__nav" aria-label="Navigation principale">
          {links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          ))}
          {cta && (
            <a href={cta.href} class="hdr__cta" data-cta-compte>
              {cta.label}
            </a>
          )}
        </nav>
      )
    }
  </div>
</header>

<script>
  /* « Se connecter » devient « Mon compte » quand une session existe.
   *
   * On regarde seulement si la clé est PRÉSENTE dans le localStorage, sans
   * charger le SDK ni interroger Supabase : l'en-tête est sur toutes les pages,
   * landing comprise, et n'a pas à payer 55 Ko pour un libellé. Une session
   * expirée affiche donc « Mon compte » à tort — sans conséquence : /compte
   * vérifie pour de bon, et renvoie vers /connexion si besoin. */
  import { CLE_SESSION } from '../lib/session-cle';
  import { HEADER_CTA_CONNECTE } from '../lib/nav';

  let connecte = false;
  try {
    connecte = window.localStorage.getItem(CLE_SESSION) !== null;
  } catch {
    // Stockage bloqué (navigation privée stricte) : on garde « Se connecter ».
  }
  const cta = document.querySelector<HTMLAnchorElement>('[data-cta-compte]');
  if (connecte && cta) {
    cta.href = HEADER_CTA_CONNECTE.href;
    cta.textContent = HEADER_CTA_CONNECTE.label;
  }
</script>

<style>
  .hdr {
    border-bottom: 1px solid var(--bois-300);
    background: var(--app-bg);
  }

  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 64px;
  }

  .hdr__home {
    text-decoration: none;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .hdr__nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .hdr__nav a:hover {
    color: var(--ink);
  }

  .hdr__nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* Le seul emploi de la menthe pleine : agir. Le texte est posé en
     --accent-ink et non en blanc — la menthe 500 est une surface à 2,2:1. */
  .hdr__cta {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--accent-ink) !important;
    /* Un bouton ne se casse pas en deux lignes : sur un téléphone de 360 px,
       « Se connecter » passait sous lui-même. */
    white-space: nowrap;
  }

  .hdr__cta:hover {
    background: var(--accent-press);
  }

  @media (max-width: 30rem) {
    .hdr__nav {
      gap: var(--space-4);
    }

    .hdr__cta {
      padding-inline: var(--space-3);
    }
  }
</style>
