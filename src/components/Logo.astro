---
/**
 * Marque TagePocket : la pastille « poche + dents » suivie du mot-symbole.
 *
 * Le SVG est inline plutôt que dans un <img> pour trois raisons : il pèse
 * 500 octets, il évite une requête, et il reste net à toutes les densités.
 * Le `logo.png` complet de l'app n'est pas utilisable ici — sous 48 px Gaston
 * devient illisible, c'est précisément pourquoi la marque simplifiée existe
 * (voir assets/brand/README.md du dépôt de l'app).
 *
 * Le néon #2AFFA6 et les incisives blanches sont dessinés pour le fond de
 * marque #02110D : la pastille sombre n'est pas une décoration, elle est ce
 * qui rend la marque lisible sur un fond clair.
 */
interface Props {
  /**
   * Hauteur de la pastille, en pixels. Le mot-symbole suit.
   *
   * Valeurs FERMÉES, et c'est délibéré. La taille du mot se calculait avant
   * dans un `style="--mark-size: 30px"` posé sur l'élément : un attribut de
   * style en ligne, que `style-src 'self'` bloque (SCRUM-198). Un attribut de
   * style relève de `style-src-attr`, qui retombe sur `style-src` faute de
   * mieux, donc l'autoriser reviendrait à rouvrir `'unsafe-inline'` pour un
   * chiffre décoratif.
   *
   * La conséquence est qu'une nouvelle taille s'ajoute ici ET dans la feuille
   * de style ci-dessous. C'est le prix, et il est faible : le composant a deux
   * appelants.
   */
  size?: 26 | 30 | 40;
  /** Masquer le mot-symbole — pour les contextes très étroits. */
  markOnly?: boolean;
}

const { size = 30, markOnly = false } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <svg
    class="logo__mark"
    viewBox="0 0 512 512"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    <rect width="512" height="512" rx="104" fill="var(--encre)"></rect>
    <path
      d="M 86.5,121.1 A 20.8,20.8 0 0 1 107.3,100.3
         H 404.7 A 20.8,20.8 0 0 1 425.5,121.1
         V 282.5 A 169.5,129.2 0 0 1 86.5,282.5 Z"
      fill="none"
      stroke="var(--neon)"
      stroke-width="39.8"
      stroke-linejoin="round"></path>
    <rect x="208.9" y="185.8" width="43.6" height="76.2" rx="14.5" fill="#fff"></rect>
    <rect x="259.5" y="185.8" width="43.6" height="76.2" rx="14.5" fill="#fff"></rect>
  </svg>
  {markOnly ? <span class="visually-hidden">TagePocket</span> : <span class="logo__word">TagePocket</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .logo__mark {
    flex: none;
  }

  .logo__word {
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  /* 0,62 fois la hauteur de la pastille : le mot arrive à peu près à la
     hauteur des incisives, et l'ensemble se lit comme un seul bloc. */
  .logo--26 .logo__word {
    font-size: 16px;
  }

  .logo--30 .logo__word {
    font-size: 19px;
  }

  .logo--40 .logo__word {
    font-size: 25px;
  }
</style>
