---
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Tenir la page hors des moteurs — /compte/*, pages de contrôle. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/* Astro.site vient de `site` dans astro.config.mjs.
   `build.format: 'file'` fait que `Astro.url.pathname` porte l'extension du
   fichier écrit : `/index.html`, `/404.html`. Ce n'est PAS l'URL publique —
   Workers sert ces fichiers à `/` et `/404`. Laisser passer l'extension
   donnerait une balise canonique en désaccord avec le sitemap, qui liste `/` :
   deux URLs pour une page, et le moteur choisit à notre place.
   On retire donc `index.html` puis l'extension, et on garde la barre finale
   pour la seule racine — là encore, pour coller au sitemap. */
const chemin = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(chemin, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/mark-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/mark-192.png" />
    <meta name="theme-color" content="#eef1ea" />

    {/* Seule la graisse 400 est préchargée : c'est celle du premier
        paragraphe visible. Précharger les quatre ferait entrer 56 ko en
        concurrence avec le HTML sur le chemin critique. */}
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      /* Apparition des blocs à l'entrée dans la fenêtre.
       *
       * Astro compile ce bloc en un module externe : pas de script en ligne,
       * donc `script-src 'self'` suffira à la CSP de SCRUM-198.
       *
       * L'état de départ est posé ICI et non dans la feuille de style. Si ce
       * fichier ne charge pas — erreur réseau, JavaScript coupé, robot
       * d'indexation — rien n'est masqué et la page reste entière. L'inverse
       * (un `opacity: 0` en CSS qu'un script vient lever) transforme la moindre
       * défaillance en page blanche.
       */
      const blocs = document.querySelectorAll<HTMLElement>('.reveal');
      const sobre = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (blocs.length > 0 && !sobre && 'IntersectionObserver' in window) {
        /* Un bloc déjà dans la fenêtre au moment où le module s'exécute a
           forcément été peint : l'armer reviendrait à le faire disparaître puis
           réapparaître sous les yeux du lecteur. On ne s'occupe que de ce qui
           est encore sous la ligne de flottaison. */
        const aVenir = [...blocs].filter(
          (b) => b.getBoundingClientRect().top > window.innerHeight,
        );
        aVenir.forEach((b) => b.classList.add('reveal--armee'));

        const vu = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('reveal--visible');
              // Une seule fois : le bloc ne doit pas se re-masquer en remontant.
              vu.unobserve(e.target);
            }
          },
          /* Le bas de la fenêtre est rentré de 10 % : le bloc s'anime une fois
             franchement entré, pas au ras du bord où l'effet passe inaperçu. */
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        aVenir.forEach((b) => vu.observe(b));
      }
    </script>
  </body>
</html>
