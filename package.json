  "version": "1.0.0",
  "private": true,
  "description": "Site tagepocket.fr — vitrine, compte utilisateur et abonnement premium.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
